QWEN_MODELS_DIR=/var/lib/ai-models/qwen
# ggml-org is the current upstream. Older ggerganov images do not understand
# the qwen35 GGUF architecture used by this model.
LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm
QWEN_MODEL_FILE=unsloth-qwen3.8-27b-ud-q3_k_xl.gguf
QWEN_MODEL_ID=unsloth-qwen3.8-27b-ud-q3_k_xl
# 8192 is a safe starting point for a 27B Q3 model on a 16 GB RX 7800 XT.
QWEN_CONTEXT_SIZE=8192
