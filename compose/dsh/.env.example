HOMELAB_DATA_ROOT=/srv/homelab
# Base URL OpenAI-compatible do modelo Qwen que corre no seu desk (IP NetBird do desk)
DSH_LLM_BASE_URL=http://<IP-NetBird-do-desk>:8080/v1
# qwen-q3: melhor qualidade; qwen-q2: mais contexto. O router do desktop
# carrega o escolhido sob demanda.
DSH_LLM_MODEL=qwen-q3
